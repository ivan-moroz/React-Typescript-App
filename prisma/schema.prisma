generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  age       Int
  city      String
  passwordHash String   @map("password_hash")
  position  Int      @default(0)
  assets    Asset[]
  conversationParticipants ConversationParticipant[]
  messages Message[]

  @@map("users")
}

model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  description String @default("")
  authorization String @default("INTERNAL")
  fileExtension String @default("") @map("file_extension")
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes?
  storageMode String @default("INLINE") @map("storage_mode")
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    AssetChunk[]

  @@index([userId, createdAt])
  @@map("assets")
}

model AssetChunk {
  id       Int    @id @default(autoincrement())
  assetId  String @map("asset_id") @db.Uuid
  position Int
  data     Bytes
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, position])
  @@map("asset_chunks")
}

model Conversation {
  id           String @id @default(uuid()) @db.Uuid
  directKey    String @unique @map("direct_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt, id])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @db.Uuid @map("conversation_id")
  userId         Int @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid @map("conversation_id")
  senderId       Int @map("sender_id")
  content        String @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")
  deletedAt      DateTime? @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, readAt, senderId])
  @@map("messages")
}
